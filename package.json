{
  "name": "tgen-electron-app",
  "version": "1.0.0",
  "private": true,
  "description": "TGen Electron template — config-driven desktop app (Windows MVP)",
  "author": "TGen",
  "main": "electron/main.js",
  "scripts": {
    "dev": "cd app && vite",
    "build:app": "cd app && vite build",
    "generate": "node scripts/generate.mjs",
    "dist:win": "npm run build:app && electron-builder --win nsis"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.3",
    "typescript": "^5.8.3",
    "vite": "^6.0.0"
  },
  "build": {
    "appId": "{{PACKAGE_NAME}}",
    "productName": "{{APP_NAME}}",
    "copyright": "Generated with TGen",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "npmRebuild": true,
    "buildDependenciesFromSource": false,
    "files": [
      "electron/**/*",
      "package.json",
      "app/dist/**/*",
      "app.config.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3"
  }
}
